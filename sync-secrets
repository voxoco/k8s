#!/bin/bash
# Pulls every secret from GCP Secret Manager and applies it to one cluster.
# Usage: ./sync-secrets <kube-context> <namespace>
#   e.g. ./sync-secrets gke_voxo-5060_us-west2-b_us-west2 production
# Pods only read secrets at startup: rollout restart affected deployments afterwards.
set -euo pipefail

if [ $# -ne 2 ]; then
  echo "Usage: $0 <kube-context> <namespace>"
  exit 1
fi
CONTEXT=$1
NAMESPACE=$2
REGION=${CONTEXT##*_}

COUNTER=$(mktemp)
MANIFEST=$(mktemp)
trap 'rm -f "$COUNTER" "$MANIFEST"' EXIT
echo 0 > "$COUNTER"
TOTAL=$(grep -o '\$(fetch [a-z]' "$0" | wc -l | tr -d ' ')

# Each fetch runs in its own subshell, so the progress count lives in a file.
fetch() {
  local n=$(( $(cat "$COUNTER") + 1 ))
  echo "$n" > "$COUNTER"
  printf '\r\033[K[%d/%d] Fetching %s' "$n" "$TOTAL" "$1" >&2
  gcloud secrets versions access latest --secret="$1"
}

render() {
cat <<EOF
apiVersion: v1
kind: Secret
metadata:
  name: api-auth-secret
  namespace: $NAMESPACE
type: Opaque
stringData:
  authSecret: $(fetch api-auth-secret | grep -m1 "")

---

