}

render > "$MANIFEST"
printf '\r\033[KFetched %d values from Secret Manager\n' "$TOTAL" >&2

# A failed gcloud fetch renders an empty value; applying it would wipe the live secret.
EMPTY=$(awk '/: \|$/ {block=1; next} block && /^ *$/ {print "line " NR " (block value)"} {block=0} /^  [A-Za-z0-9._-]+:[[:space:]]*$/ {print "line " NR ": " $0}' "$MANIFEST")
if [ -n "$EMPTY" ]; then
  echo "Aborting: empty secret values rendered (gcloud access failed?):"
  echo "$EMPTY"
  exit 1
fi

echo "Comparing with $CONTEXT / $NAMESPACE..."
DIFF=$(kubectl --context "$CONTEXT" diff -f "$MANIFEST") || [ $? -eq 1 ]

# kubectl diff prints one block per changed object; reduce it to secret name + changed data keys.
CHANGES=$(awk '
  /^diff -u -N / { n = split($NF, p, "."); name = p[n]; order[++c] = name; next }
  /^@@ -0,0 / { isnew[name] = 1 }
  /^[-+ ]/ { line = substr($0, 2); if (line ~ /^[a-zA-Z]/) inData = (line ~ /^data:/) }
  inData && /^[-+]  [^ ]/ {
    k = $2; sub(/:$/, "", k)
    if (!((name, k) in seen)) { seen[name, k] = 1; keys[name] = keys[name] (keys[name] ? ", " : "") k }
  }
  END { for (i = 1; i <= c; i++) printf "  %-32s %s%s\n", order[i], keys[order[i]], (isnew[order[i]] ? "  (new)" : "") }
' <<< "$DIFF")

SECRET_COUNT=$(grep -c '^kind: Secret' "$MANIFEST")
if [ -z "$CHANGES" ]; then
  echo "All $SECRET_COUNT secrets already match Secret Manager. Nothing to apply."
  exit 0
fi
echo
echo "$(grep -c . <<< "$CHANGES") of $SECRET_COUNT secrets will change (secret / changed keys):"
echo "$CHANGES"
echo

read -p "Apply to $CONTEXT (y/n)? " choice
case "$choice" in
  y|Y ) kubectl --context "$CONTEXT" apply -f "$MANIFEST" ;;
  * ) echo "Exiting"; exit 1 ;;
esac
